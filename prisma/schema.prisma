// This is your Prisma schema file
// MongoDB with Prisma documentation: https://pris.ly/d/mongodb

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NOTE: The Card type is defined in TypeScript (src/data/cards.ts)
// and includes fields: rarity (COMMUNE | RARE | LEGENDAIRE), imageUrl?: string | null.
// Cards are stored as JSON in UserCollection.cards — no Prisma model needed.

// Collection / Season
model Collection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  userCollections UserCollection[]
}

// User model for authentication
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // hashed password
  firstName String?
  lastName  String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Daily quotas
  boostersOpenedToday Int      @default(0)
  tradesMadeToday     Int      @default(0)
  lastResetDate       DateTime?

  // Daily Streak
  currentStreak   Int        @default(0)
  lastLoginDate   DateTime?

  // Virtual currency for marketplace
  tokens          Int        @default(0)

  // Total stats for badges
  totalRecycles         Int     @default(0)
  totalBoostersOpened   Int     @default(0)
  totalLegendaries      Int     @default(0)
  totalCardsObtained    Int     @default(0)
  totalTrades           Int     @default(0)
  totalFusionsDone      Int     @default(0)
  totalMarketPurchases  Int     @default(0)

  // Daily quests stored as embedded JSON (replaced atomically via $set)
  dailyQuests         Json     @default("[]")

  // Achievements & badges
  badges          Json       @default("[]")

  // Public album sharing
  isPublicAlbum   Boolean    @default(false)

  // Notification preferences
  notifyBoosterReminder  Boolean @default(true)
  notifyMarketplaceAlert Boolean @default(true)
  notifyBadgeUnlocked    Boolean @default(true)

  // Role: "member" or "admin"
  role    String @default("member")

  // Relations
  collections       UserCollection[]
  sentExchanges     Exchange[]        @relation("Requester")
  receivedExchanges Exchange[]        @relation("Recipient")
  tradeSessions     TradeSession[]    @relation("TradeCreator")
  boosterLogs       BoosterLog[]
  tradeLogsGiven    TradeLog[]        @relation("TradeGiver")
  tradeLogsReceived TradeLog[]        @relation("TradeReceiver")
  pushSubscriptions PushSubscription[]
  quests            UserQuest[]
  marketplaceListings MarketplaceListing[]
  clanMemberships   ClanMember[]
  clanRequests      ClanRequest[]

  // New economy & customization fields
  // Inventory stored as JSON: { charms: number, dust: number, ... }
  inventory        Json     @default("{\"charms\":0,\"dust\":0}")

  // Showcase: array of up to 5 pinned card IDs
  showcase         Json     @default("[]")

  // Card backs (cosmetics)
  unlockedCardBacks Json    @default("[]")
  activeCardBack    String?
  // Separate counters for charms (amulets) and dust
  charms            Int      @default(0)
  charmActiveUntil  DateTime?
  dust              Int      @default(0)
  charmReserved     Boolean  @default(false)
}

// Pool of quest templates used to generate daily quests
model QuestPool {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  title     String
  description String
  target    Int
  // a short type code e.g. OPEN_BOOSTER, RECYCLE_CARD, OBTAIN_RARITY
  type      String
  params    Json     @default("{}")
  createdAt DateTime @default(now())
}

// History of card market values
model CardValueHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cardId    String
  date      DateTime @default(now())
  avgPrice  Int
  createdAt DateTime @default(now())

  @@index([cardId])
  @@index([date])
}

// User's card collection per season
model UserCollection {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  collectionId String   @db.ObjectId

  // Store cards as JSON: { cardId: quantity, ... }
  cards      Json       @default("{}")
  // Shiny/fused cards: [cardId, ...]
  shinyCards Json       @default("[]")
  // Card acquisition dates: { cardId: ISO-date-string, ... }
  cardDates  Json       @default("{}")
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  // Compound index for the main query pattern: findUnique({ userId_collectionId })
  @@unique([userId, collectionId])
  // Individual indexes for filtered queries by user or collection alone
  @@index([userId])
  @@index([collectionId])
  // Index on updatedAt for paginated list queries ordered by last update
  @@index([updatedAt])
}

// Exchange system between users
model Exchange {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId      String   @db.ObjectId
  recipientId      String   @db.ObjectId

  // Cards being offered/requested (stored as JSON: { cardId: quantity, ... })
  offeredCards     Json     // what requester is offering
  requestedCards   Json     // what requester wants

  status           String   @default("pending") // pending, accepted, rejected, completed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

// Trade session for room-code-based exchanges
model TradeSession {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique
  creatorId     String   @db.ObjectId
  cardOfferedId String
  status        String   @default("OPEN") // OPEN, COMPLETED, EXPIRED
  createdAt     DateTime @default(now())

  creator User @relation("TradeCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Password reset tokens for "forgot password" flow
model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Log of booster pack openings
model BoosterLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  collectionId String   @db.ObjectId
  cardIds      Json     // string[] of card IDs drawn
  rarityCounts Json     // { COMMUNE: number, RARE: number, LEGENDAIRE: number }
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Log of completed trades
model TradeLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  giverId     String   @db.ObjectId
  receiverId  String   @db.ObjectId
  cardGivenId String
  cardReceivedId String
  sessionCode String
  createdAt   DateTime @default(now())

  giver    User @relation("TradeGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver User @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([giverId])
  @@index([receiverId])
  @@index([createdAt])
}

// Custom cards created by admin (stored in DB, not in static TS files)
model CustomCard {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rarity       String   // COMMUNE, RARE, LEGENDAIRE
  number       Int
  collectionSlug String // e.g. "s25-26"
  imageUrl     String?
  category     String   @default("Custom")
  firstName    String?
  lastName     String?
  role         String   @default("joueur")
  team         String   @default("ECC")
  photo        String   @default("/logo-club.png")
  createdAt    DateTime @default(now())
  createdBy    String   @db.ObjectId
}

// Marketplace listing for token-based card trading
model MarketplaceListing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sellerId  String   @db.ObjectId
  cardId    String
  price     Int
  status    String   @default("active") // active, sold, cancelled
  createdAt DateTime @default(now())

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([cardId])
}

// User-specific quest progress
model UserQuest {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  questId        String   // references a quest definition key
  progress       Int      @default(0)
  target         Int
  completed      Boolean  @default(false)
  rewardClaimed  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
}

// Clan / Guild system
model Clan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  avatar      String?
  weeklyXP    Int      @default(0)
  maxMembers  Int      @default(20)
  createdAt   DateTime @default(now())

  members     ClanMember[]
  requests    ClanRequest[]
}

model ClanMember {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId  String   @db.ObjectId
  userId  String   @db.ObjectId
  role    String   @default("member") // 'leader' | 'member'
  joinedAt DateTime @default(now())

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([userId])
}

model ClanRequest {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId           String   @db.ObjectId
  userId           String   @db.ObjectId
  cardIdRequested  String
  status           String   @default("open") // 'open' | 'fulfilled'
  createdAt        DateTime @default(now())

  clan  Clan  @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clanId, status])
}

// Flash Events (Happy Hours)
model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String   // 'happy_hour'
  startTime DateTime
  endTime   DateTime
  active    Boolean  @default(false)
  modification Json  // { boosterBonusChance: number, recycleCostReduction: number }
  createdAt DateTime @default(now())

  @@index([active])
  @@index([type])
}

// Web Push subscriptions
model PushSubscription {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  endpoint        String   @unique
  p256dh          String
  auth            String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
