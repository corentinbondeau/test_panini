// This is your Prisma schema file
// MongoDB with Prisma documentation: https://pris.ly/d/mongodb

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NOTE: The Card type is defined in TypeScript (src/data/cards.ts)
// and includes an `imageUrl?: string | null` field for future real photos.
// Cards are stored as JSON in UserCollection.cards — no Prisma model needed.

// Collection / Season
model Collection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  userCollections UserCollection[]
}

// User model for authentication
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // hashed password
  name      String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Daily quotas
  boostersOpenedToday Int      @default(0)
  tradesMadeToday     Int      @default(0)
  lastResetDate       DateTime?

  // Relations
  collections     UserCollection[]
  sentExchanges   Exchange[]      @relation("Requester")
  receivedExchanges Exchange[]    @relation("Recipient")
}

// User's card collection per season
model UserCollection {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  collectionId String   @db.ObjectId

  // Store cards as JSON: { cardId: quantity, ... }
  cards      Json       @default("{}")
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@index([userId])
  @@index([collectionId])
}

// Exchange system between users
model Exchange {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId      String   @db.ObjectId
  recipientId      String   @db.ObjectId

  // Cards being offered/requested (stored as JSON: { cardId: quantity, ... })
  offeredCards     Json     // what requester is offering
  requestedCards   Json     // what requester wants

  status           String   @default("pending") // pending, accepted, rejected, completed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}
