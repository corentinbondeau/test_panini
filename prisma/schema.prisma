// This is your Prisma schema file
// MongoDB with Prisma documentation: https://pris.ly/d/mongodb

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// NOTE: The Card type is defined in TypeScript (src/data/cards.ts)
// and includes fields: rarity (COMMUNE | RARE | LEGENDAIRE), imageUrl?: string | null.
// Cards are stored as JSON in UserCollection.cards — no Prisma model needed.

// Collection / Season
model Collection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  userCollections UserCollection[]
}

// User model for authentication
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String   // hashed password
  firstName String?
  lastName  String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Daily quotas
  boostersOpenedToday Int      @default(0)
  tradesMadeToday     Int      @default(0)
  lastResetDate       DateTime?

  // Role: "member" or "admin"
  role    String @default("member")

  // Relations
  collections       UserCollection[]
  sentExchanges     Exchange[]        @relation("Requester")
  receivedExchanges Exchange[]        @relation("Recipient")
  tradeSessions     TradeSession[]    @relation("TradeCreator")
  boosterLogs       BoosterLog[]
  tradeLogsGiven    TradeLog[]        @relation("TradeGiver")
  tradeLogsReceived TradeLog[]        @relation("TradeReceiver")
  pushSubscriptions PushSubscription[]
}

// User's card collection per season
model UserCollection {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  collectionId String   @db.ObjectId

  // Store cards as JSON: { cardId: quantity, ... }
  cards      Json       @default("{}")
  updatedAt  DateTime   @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@index([userId])
  @@index([collectionId])
}

// Exchange system between users
model Exchange {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId      String   @db.ObjectId
  recipientId      String   @db.ObjectId

  // Cards being offered/requested (stored as JSON: { cardId: quantity, ... })
  offeredCards     Json     // what requester is offering
  requestedCards   Json     // what requester wants

  status           String   @default("pending") // pending, accepted, rejected, completed

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requester User @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([requesterId])
  @@index([recipientId])
  @@index([status])
}

// Trade session for room-code-based exchanges
model TradeSession {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  code          String   @unique
  creatorId     String   @db.ObjectId
  cardOfferedId String
  status        String   @default("OPEN") // OPEN, COMPLETED, EXPIRED
  createdAt     DateTime @default(now())

  creator User @relation("TradeCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Password reset tokens for "forgot password" flow
model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Log of booster pack openings
model BoosterLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  collectionId String   @db.ObjectId
  cardIds      Json     // string[] of card IDs drawn
  rarityCounts Json     // { COMMUNE: number, RARE: number, LEGENDAIRE: number }
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Log of completed trades
model TradeLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  giverId     String   @db.ObjectId
  receiverId  String   @db.ObjectId
  cardGivenId String
  cardReceivedId String
  sessionCode String
  createdAt   DateTime @default(now())

  giver    User @relation("TradeGiver", fields: [giverId], references: [id], onDelete: Cascade)
  receiver User @relation("TradeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([giverId])
  @@index([receiverId])
  @@index([createdAt])
}

// Custom cards created by admin (stored in DB, not in static TS files)
model CustomCard {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  rarity       String   // COMMUNE, RARE, LEGENDAIRE
  number       Int
  collectionSlug String // e.g. "s25-26"
  imageUrl     String?
  category     String   @default("Custom")
  firstName    String?
  lastName     String?
  role         String   @default("joueur")
  team         String   @default("ECC")
  photo        String   @default("/logo-club.png")
  createdAt    DateTime @default(now())
  createdBy    String   @db.ObjectId
}

// Web Push subscriptions
model PushSubscription {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @db.ObjectId
  endpoint        String   @unique
  p256dh          String
  auth            String
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
