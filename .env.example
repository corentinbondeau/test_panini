# ─── Base de données (MongoDB) ─────────────
# Créez un cluster gratuit sur https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://corentin:1234@cluster0.7fjrmwh.mongodb.net/panini?retryWrites=true&w=majority"

# ─── Authentification JWT ──────────────────
# Générez une chaîne aléatoire (ex: openssl rand -hex 32)
